<Window Icon="/FreeAppLock;component/Assets/AppLock.ico" Background="{DynamicResource BackgroundBrush}" Foreground="{DynamicResource TextBrush}" x:Class="FreeAppLock.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:local="clr-namespace:FreeAppLock" Title="{x:Static local:App.WindowTitle}" Width="1150" Height="780" MinWidth="910" MinHeight="620" WindowStartupLocation="CenterScreen">
 <Window.Resources>
  <Style x:Key="RowStyle" TargetType="ListViewItem">
   <Setter Property="Height" Value="53"/><Setter Property="HorizontalContentAlignment" Value="Stretch"/><Setter Property="Background" Value="Transparent"/><Setter Property="FocusVisualStyle" Value="{x:Null}"/>
   <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ListViewItem">
    <Grid Background="Transparent" Margin="0"><Border x:Name="Row" Background="{TemplateBinding Background}" BorderBrush="#1C2430" BorderThickness="0,0,0,1" Padding="12,0"><GridViewRowPresenter Content="{TemplateBinding Content}" Columns="{Binding View.Columns, RelativeSource={RelativeSource AncestorType=ListView}}" VerticalAlignment="Center"/></Border>
    <Border x:Name="SelectionAccent" Width="3" HorizontalAlignment="Left" Background="{StaticResource AccentBrush}" Visibility="Collapsed"/>
    </Grid>
    <ControlTemplate.Triggers>
     <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Row" Property="Background" Value="#1C2430"/></Trigger>
     <Trigger Property="IsSelected" Value="True"><Setter TargetName="Row" Property="Background" Value="#1F3A4D"/><Setter TargetName="SelectionAccent" Property="Visibility" Value="Visible"/></Trigger>
     <Trigger Property="IsKeyboardFocusWithin" Value="True"><Setter TargetName="Row" Property="BorderBrush" Value="#4DC1DA"/></Trigger>
    </ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter>
  </Style>
  <Style x:Key="HeaderStyle" TargetType="GridViewColumnHeader" BasedOn="{StaticResource {x:Type GridViewColumnHeader}}"/>
 </Window.Resources>
 <Grid Margin="30,24,30,16"><Grid.RowDefinitions><RowDefinition Height="80"/><RowDefinition Height="92"/><RowDefinition Height="58"/><RowDefinition Height="*"/><RowDefinition Height="56"/></Grid.RowDefinitions>
  <Grid Grid.Row="0"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><StackPanel Orientation="Horizontal" VerticalAlignment="Center"><Image Source="/FreeAppLock;component/Assets/AppLock.png" Width="46" Height="46" Margin="0,0,14,0"/><StackPanel><TextBlock x:Name="AppHeading" Text="{x:Static local:App.DisplayName}" FontSize="26" FontWeight="SemiBold"/><TextBlock Text="Private by default. Protected on access." Foreground="{StaticResource MutedBrush}" Margin="0,3,0,0"/></StackPanel></StackPanel><Border Grid.Column="1" Background="#17392F" CornerRadius="18" Height="38" Padding="16,0" Margin="8" VerticalAlignment="Center"><TextBlock x:Name="MonitorStatus" Text="●  Monitoring active" Foreground="#6FDCA4" FontWeight="SemiBold" VerticalAlignment="Center"/></Border><Button Grid.Column="2" Content="⚙  Settings" Margin="8,0,0,0" VerticalAlignment="Center" Click="Settings_Click"/></Grid>
  <Border Grid.Row="1" Background="{StaticResource SurfaceBrush}" CornerRadius="12" Padding="17,14" Margin="0,4,0,15" BorderBrush="{StaticResource StrokeBrush}" BorderThickness="1"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><Grid><TextBox x:Name="Search" TextChanged="Search_TextChanged" Padding="34,9,12,9" ToolTip="Search apps and window titles"/><TextBlock Text="⌕" FontSize="22" Margin="12,3,0,0" VerticalAlignment="Center" HorizontalAlignment="Left" Foreground="{StaticResource MutedBrush}" IsHitTestVisible="False"/><TextBlock x:Name="SearchHint" Text="Search applications or window titles" Margin="38,0,0,0" VerticalAlignment="Center" Foreground="{StaticResource MutedBrush}" IsHitTestVisible="False"/></Grid><Button Grid.Column="1" x:Name="LockButton" Content="Lock selected" Style="{StaticResource PrimaryButton}" Margin="12,0,8,0" Click="Lock_Click"/><Button Grid.Column="2" Content="Unlock" Click="Unlock_Click"/></Grid></Border>
  <Grid Grid.Row="2"><TextBlock Text="Running applications" FontSize="18" FontWeight="SemiBold" VerticalAlignment="Center"/><StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center"><CheckBox x:Name="ShowSystem" Content="Show background processes" Checked="ShowSystem_Changed" Unchecked="ShowSystem_Changed" Margin="0,0,16,0"/><TextBlock x:Name="Count" Text="" Foreground="{StaticResource MutedBrush}" VerticalAlignment="Center"/></StackPanel></Grid>
  <Border Grid.Row="3" Background="{StaticResource SurfaceBrush}" CornerRadius="12" BorderBrush="{StaticResource StrokeBrush}" BorderThickness="1" ClipToBounds="True"><ListView x:Name="Apps" SizeChanged="Apps_SizeChanged" SelectionChanged="Apps_SelectionChanged" ScrollViewer.HorizontalScrollBarVisibility="Disabled" KeyboardNavigation.TabNavigation="Continue" ScrollViewer.VerticalScrollBarVisibility="Auto" Background="Transparent" BorderThickness="0" Foreground="{StaticResource TextBrush}" ItemContainerStyle="{StaticResource RowStyle}" SelectionMode="Single"><ListView.View><GridView AllowsColumnReorder="False"><GridViewColumn Header="APPLICATION" Width="245" HeaderContainerStyle="{StaticResource HeaderStyle}"><GridViewColumn.CellTemplate><DataTemplate><StackPanel Orientation="Horizontal" VerticalAlignment="Center"><Image Source="{Binding Icon}" Width="24" Height="24" Margin="0,0,12,0"/><TextBlock Text="{Binding Name}" VerticalAlignment="Center" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/></StackPanel></DataTemplate></GridViewColumn.CellTemplate></GridViewColumn><GridViewColumn x:Name="TitleColumn" Header="WINDOW TITLE" Width="410" HeaderContainerStyle="{StaticResource HeaderStyle}"><GridViewColumn.CellTemplate><DataTemplate><TextBlock Text="{Binding Title}" TextTrimming="CharacterEllipsis" Foreground="{StaticResource MutedBrush}"/></DataTemplate></GridViewColumn.CellTemplate></GridViewColumn><GridViewColumn Header="PROCESSES" Width="118" HeaderContainerStyle="{StaticResource HeaderStyle}"><GridViewColumn.CellTemplate><DataTemplate><TextBlock Text="{Binding ProcessLabel}" ToolTip="{Binding ProcessDetail}"/></DataTemplate></GridViewColumn.CellTemplate></GridViewColumn><GridViewColumn Header="STATUS" Width="152" HeaderContainerStyle="{StaticResource HeaderStyle}"><GridViewColumn.CellTemplate><DataTemplate><Border Background="{Binding BadgeBackground}" ToolTip="{Binding StatusDetail}" CornerRadius="11" Padding="10,5" HorizontalAlignment="Left"><TextBlock Text="{Binding State}" Foreground="{Binding BadgeForeground}" FontWeight="SemiBold"/></Border></DataTemplate></GridViewColumn.CellTemplate></GridViewColumn></GridView></ListView.View></ListView></Border>
  <Grid Grid.Row="4"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><StackPanel Orientation="Horizontal" VerticalAlignment="Center"><TextBlock Text="ⓘ" Foreground="{StaticResource MutedBrush}" FontSize="18" Margin="0,0,8,0"/><TextBlock Text="Reactive protection • not pre-launch blocking or tamper-proof security." Foreground="{StaticResource MutedBrush}" VerticalAlignment="Center"/></StackPanel><TextBlock x:Name="Notice" Grid.Column="1" Text="Ready" Foreground="{StaticResource MutedBrush}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" MaxWidth="360"/></Grid>
 </Grid>
</Window>
