<Window Icon="/FreeAppLock;component/Assets/AppLock.ico" Background="{DynamicResource BackgroundBrush}" Foreground="{DynamicResource TextBrush}" x:Class="FreeAppLock.Views.SettingsWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="FreeAppLock — Settings" Width="570" Height="650" MinHeight="520" ResizeMode="CanResize" WindowStartupLocation="CenterOwner"><Border Padding="30,20"><ScrollViewer VerticalScrollBarVisibility="Auto"><StackPanel><TextBlock Text="Settings" FontSize="26" FontWeight="SemiBold"/><TextBlock Text="Protected changes require your admin password." Foreground="{StaticResource MutedBrush}" Margin="0,7,0,24"/><Border Background="{StaticResource SurfaceBrush}" CornerRadius="12" Padding="22" BorderBrush="{StaticResource StrokeBrush}" BorderThickness="1"><StackPanel><TextBlock Text="PROTECTION &amp; STARTUP" Foreground="{StaticResource AccentBrush}" FontWeight="SemiBold" Margin="0,0,0,12"/><CheckBox x:Name="Monitoring" Content="Enable monitoring" Click="Monitoring_Click"/><CheckBox x:Name="AutoStart" Content="Launch at Windows login" Click="AutoStart_Click"/><TextBlock Text="Relock after switching away (minutes)" Margin="0,20,0,8"/><StackPanel Orientation="Horizontal"><TextBox x:Name="Delay" Height="36" Width="80" MaxLength="4" TextAlignment="Center" HorizontalAlignment="Left" Text="0" PreviewTextInput="Delay_PreviewTextInput"/><TextBlock Text="minutes" Foreground="{StaticResource MutedBrush}" VerticalAlignment="Center" Margin="10,0,16,0"/><Button Content="Save delay" Height="36" Width="102" Click="Delay_Click"/></StackPanel><TextBlock Text="Set to 0 to relock immediately after switching away. When relocked, the protected window is minimized. Manually minimizing an unlocked protected app also relocks it." TextWrapping="Wrap" Foreground="{StaticResource MutedBrush}" Margin="0,13,0,6"/></StackPanel></Border><Border Background="{StaticResource SurfaceBrush}" CornerRadius="12" Padding="22" BorderBrush="{StaticResource StrokeBrush}" BorderThickness="1" Margin="0,16,0,0"><StackPanel><TextBlock Text="FAILED UNLOCK ATTEMPTS" Foreground="{StaticResource AccentBrush}" FontWeight="SemiBold" Margin="0,0,0,12"/>
<CheckBox x:Name="TerminateOnFailures" Content="Terminate app after five wrong unlock attempts" Click="TerminateOnFailures_Click"/>
<TextBlock Text="OFF by default. When disabled, the window stays locked for 60 seconds instead of closing the app. Recognized browsers always use the safe cooldown to preserve tabs. For other apps, enabling termination can permanently lose unsaved work, including other windows in the same process." TextWrapping="Wrap" Foreground="{StaticResource MutedBrush}" Margin="0,10,0,8"/>
</StackPanel></Border>
<Border Background="{StaticResource SurfaceBrush}" CornerRadius="12" Padding="22" BorderBrush="{StaticResource StrokeBrush}" BorderThickness="1" Margin="0,16,0,0"><StackPanel><TextBlock Text="PASSWORDS &amp; ACTIVITY" Foreground="{StaticResource AccentBrush}" FontWeight="SemiBold" Margin="0,0,0,12"/><Button Content="Change admin password" Margin="0,0,0,9" Click="Admin_Click"/><Button Content="Change app password" Margin="0,0,0,9" Click="App_Click"/><Button Content="View failed attempts" Click="History_Click"/></StackPanel></Border><Button Content="Quit FreeAppLock" Margin="0,20,0,0" HorizontalAlignment="Right" Click="Quit_Click"/><TextBlock x:Name="Status" Foreground="{StaticResource MutedBrush}" Margin="0,12,0,0" TextWrapping="Wrap"/></StackPanel></ScrollViewer></Border></Window>
