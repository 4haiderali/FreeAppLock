<Window x:Class="FreeAppLock.Views.RuleEditorWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Icon="/FreeAppLock;component/Assets/AppLock.ico" Title="Protection rule" Width="570" SizeToContent="Height" ResizeMode="NoResize" WindowStartupLocation="CenterOwner" Background="{StaticResource BackgroundBrush}" Foreground="{StaticResource TextBrush}"><Border Padding="26"><StackPanel><TextBlock x:Name="Heading" FontSize="23" FontWeight="SemiBold"/><TextBlock x:Name="Scope" Foreground="{StaticResource MutedBrush}" Margin="0,8,0,16" TextWrapping="Wrap"/><TextBlock x:Name="NameLabel" Text="Profile name"/><TextBox x:Name="ProfileName" Height="38" MaxLength="80" Margin="0,6,0,12"/><CheckBox x:Name="AwayEnabled" Content="Lock after switching away"/><StackPanel Orientation="Horizontal" Margin="24,5,0,12"><TextBox x:Name="AwayMinutes" Width="80" Height="36"/><TextBlock Text="minutes (0 = immediately)" VerticalAlignment="Center" Margin="12,0,0,0"/></StackPanel><CheckBox x:Name="MaximumEnabled" Content="Limit each unlocked session, even while using the app"/><StackPanel Orientation="Horizontal" Margin="24,5,0,12"><TextBox x:Name="MaximumMinutes" Width="80" Height="36"/><TextBlock Text="minutes" VerticalAlignment="Center" Margin="12,0,0,0"/></StackPanel><CheckBox x:Name="MinimizeLocks" Content="Lock immediately when minimized"/><TextBlock Text="If minimize locking is off, the away timer and maximum session limit still apply. Uncheck a timer to keep it unlimited." Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap" Margin="0,10,0,12"/><CheckBox x:Name="ProfileOnly" Content="Use profile-only mode for this browser"/><TextBlock x:Name="ProfileOnlyHelp" Text="Removes this browser's app-wide rule, so unselected profiles remain free. Other protected profile rules are kept." Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap" Margin="24,4,0,10"/><TextBlock x:Name="Feedback" Foreground="#F49B8C" TextWrapping="Wrap" MinHeight="28"/><StackPanel Orientation="Horizontal" HorizontalAlignment="Right"><Button Content="Cancel" IsCancel="True" Click="Cancel_Click" Margin="0,0,10,0"/><Button Content="Save rule" IsDefault="True" Style="{StaticResource PrimaryButton}" Click="Save_Click"/></StackPanel></StackPanel></Border></Window>
