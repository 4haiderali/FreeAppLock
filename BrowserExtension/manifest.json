{
  "manifest_version": 3,
  "name": "FreeAppLock Profile Companion",
  "version": "1.1.0",
  "description": "Connect this browser profile to FreeAppLock. Window-level privacy controls; no browsing-content permissions.",
  "key": "",
  "permissions": [
    "nativeMessaging",
    "storage",
    "alarms"
  ],
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "FreeAppLock profile"
  },
  "icons": {
    "128": "icon.png"
  },
  "minimum_chrome_version": "120",
  "incognito": "not_allowed"
}
